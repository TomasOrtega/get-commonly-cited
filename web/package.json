{
  "name": "commonly-cited-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "predev": "cd .. && uv run --group docs mkdocs build --strict --site-dir web/public/docs",
    "dev": "vite",
    "lint": "eslint .",
    "prepreview": "cd .. && uv run --group docs mkdocs build --strict --site-dir web/dist/docs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
